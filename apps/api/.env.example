NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 必填；pnpm env:init 会从根目录 .env 生成本地连接字符串。
DATABASE_URL=
## 独立测试数据库；必须以 _test 结尾，禁止填写开发/生产数据库。
TEST_DATABASE_URL=
# 生产环境默认关闭 Swagger；仅在需要时显式开启。
SWAGGER_ENABLED=true
# pnpm env:init 为本地生成随机密钥；生产单独配置至少 32 字节强随机密钥。
JWT_SECRET=
JWT_ISSUER=flowdesk-api
JWT_AUDIENCE=flowdesk-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_SESSION_TTL_DAYS=7
# 本地 HTTP 为 false；生产必须 true 且来源使用 HTTPS。
COOKIE_SECURE=false
